{
  "$schema": "https://json.schemastore.org/lintstagedrc.json",
  "**/*.{ts,tsx,js,jsx,mjs,cjs}": [
    "node ./node_modules/eslint/bin/eslint.js --fix --no-warn-ignored --max-warnings=0",
    "node ./node_modules/prettier/bin/prettier.cjs --write --ignore-unknown"
  ],
  "**/*.{json,md,css,html,yml,yaml}": [
    "node ./node_modules/prettier/bin/prettier.cjs --write --ignore-unknown"
  ]
}
