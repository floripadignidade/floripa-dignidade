{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "noEmit": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "incremental": true,
    /* 🛡️ SANEADO: La coma final fue eliminada. Se inyectan tipos globales de Next.js */
    "types": ["node", "next", "react", "react-dom"],
    "paths": {
      "@/*": ["./src/*"],
      "@floripa-dignidade/*": ["../../libs/*/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "index.d.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", ".next"],
  "references": [
    {
      "path": "../../libs/modules/identity"
    },
    {
      "path": "../../libs/engines/data-ingestion-engine/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/ui-contracts"
    },
    {
      "path": "../../libs/modules/whatsapp/communication-service/tsconfig.lib.json"
    },
    {
      "path": "../../libs/core/telemetry"
    },
    {
      "path": "../../libs/shared/ui-foundry"
    },
    {
      "path": "../../libs/shared/state-store/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/utility/tsconfig.lib.json"
    },
    {
      "path": "../../libs/core/routing/tsconfig.lib.json"
    },
    {
      "path": "../../libs/modules/newsletter/tsconfig.lib.json"
    },
    {
      "path": "../../libs/core/exceptions"
    },
    {
      "path": "../../libs/core/environment-validator/tsconfig.lib.json"
    }
  ]
}
