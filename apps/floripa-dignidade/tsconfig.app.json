/**
 * @section tsconfig: Emitter (Portal Shell)
 * @description Generador de ADN para la aplicación principal. Orquesta la
 * visibilidad del motor Next.js y sincroniza el mapa de rutas con la
 * arquitectura de búnkeres aplanados.
 *
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Resolución de error TS2688 (Carga de librería 'next')
 * delegando la resolución al puente de tipos ambiental.
 *
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,

    "rootDir": ".",
    "outDir": "../../dist/out-tsc/apps/floripa-dignidade",
    "tsBuildInfoFile": "../../dist/out-tsc/apps/floripa-dignidade/tsconfig.app.tsbuildinfo",

    "ignoreDeprecations": "5.0",

    "paths": {
      "@/*": ["./src/*"],
      "@floripa-dignidade/*": ["../../dist/out-tsc/libs/*/index.d.ts"]
    },

    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO --- */
    /**
     * 🛡️ SANEADO Zenith (Fix TS2688): Se remueve 'next' de este array.
     * La visibilidad de Next.js se garantiza ahora vía 'index.d.ts' mediante
     * referencia de triple barra, evitando fallos de resolución en PNPM.
     */
    "types": ["node", "react", "react-dom"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "next.config.js",
    "postcss.config.js",
    "tailwind.config.js",
    "index.d.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    ".next",
    "../../dist",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
