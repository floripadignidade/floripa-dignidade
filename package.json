{
  "name": "@floripa-dignidade/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "// --- 🏗️ INFRASTRUCTURE: I18N WEAVER ---": "",
    "weaver:build": "tsx --tsconfig ./tsconfig.base.json scripts/src/run-weaver.ts",
    "// --- 🚀 DEPLOYMENT PIPELINE (Vercel Production) ---": "",
    "build:portal": "nx build floripa-dignidade --prod",
    "build:cms": "nx build content-manager-system --prod",
    "vercel-build": "pnpm weaver:build && nx run-many -t build --projects=floripa-dignidade,content-manager-system --prod",
    "// --- 🛠️ DEVELOPMENT: ORCHESTRATION ---": "",
    "dev:portal": "nx serve floripa-dignidade",
    "dev:cms": "nx serve content-manager-system",
    "dev:all": "nx run-many -t dev --parallel=1",
    "// --- 🛡️ QUALITY AUDIT: SRE GATEKEEPER ---": "",
    "typecheck": "nx run-many -t typecheck --parallel=1",
    "lint": "nx run-many -t lint --parallel=1",
    "lint:fix": "nx run-many -t lint --fix --parallel=1",
    "format:check": "nx format:check",
    "format:write": "nx format:write",
    "audit:infrastructure": "tsx --tsconfig ./tsconfig.base.json scripts/src/audit-cloud-infrastructure-secrets.ts",
    "audit:exceptions": "tsx --tsconfig ./tsconfig.base.json scripts/src/audit-exceptions.ts",
    "// --- 📊 FINANCIAL & MUNICIPAL DATA INGESTION ---": "",
    "ingest:budget": "tsx --tsconfig ./tsconfig.base.json scripts/src/ingest-financial-budget.ts",
    "// --- 🧪 QA: FORENSIC TESTING ---": "",
    "test:unit": "nx run-many -t test",
    "test:e2e": "nx e2e floripa-dignidade-e2e",
    "// --- 🧹 WORKSPACE HYGIENE & MAINTENANCE ---": "",
    "purge:emissions": "tsx --tsconfig ./tsconfig.base.json scripts/src/purge-rogue-emissions.ts",
    "workspace:clean": "nx reset && node -e \"['dist','.nx','tmp'].forEach(directoryPathLiteral => fs.rmSync(directoryPathLiteral, { recursive: true, force: true }))\"",
    "workspace:graph": "nx graph"
  },
  "private": true,
