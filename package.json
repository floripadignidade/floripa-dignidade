{
  "//": "package.json",
  "name": "@floripa-dignidade/source",
  "version": "1.3.1",
  "license": "MIT",
  "private": true,
  "scripts": {
    "// --- 🏗️ INFRASTRUCTURE: I18N WEAVER ---": "",
    "weaver:build": "tsx --tsconfig ./tsconfig.base.json scripts/src/run-weaver.ts",
    "// --- 🚀 DEPLOYMENT PIPELINE (Vercel Production Symphony) ---": "",
    "preflight": "pnpm purge:emissions:ci && pnpm audit:workspace && pnpm format:check && pnpm weaver:build && pnpm lint && pnpm typecheck && pnpm test:unit",
    "build:portal": "pnpm weaver:build && pnpm exec nx build @floripa-dignidade/floripa-dignidade --configuration=production",
    "build:cms": "pnpm exec nx build @floripa-dignidade/content-manager-system --configuration=production",
    "vercel:build:portal": "pnpm preflight && pnpm audit:infrastructure:advisory && pnpm build:portal",
    "vercel:build:cms": "pnpm preflight && pnpm audit:infrastructure:advisory && pnpm build:cms",
    "vercel-build": "pnpm preflight && pnpm exec nx run-many -t build --projects=@floripa-dignidade/floripa-dignidade,@floripa-dignidade/content-manager-system --configuration=production --parallel=1",
    "// --- 🛠️ DEVELOPMENT: ORCHESTRATION ---": "",
    "dev:portal": "pnpm exec nx serve @floripa-dignidade/floripa-dignidade",
    "dev:cms": "pnpm exec nx serve @floripa-dignidade/content-manager-system",
    "dev:all": "pnpm exec nx run-many -t dev --parallel=1",
    "// --- 🛡️ QUALITY AUDIT: SRE GATEKEEPER ---": "",
    "validate": "pnpm preflight",
    "prepush:check": "pnpm purge:emissions:ci && pnpm audit:workspace && pnpm format:check && pnpm weaver:build && pnpm exec nx affected -t lint typecheck test --parallel=1",
    "typecheck": "pnpm exec nx run-many -t typecheck --parallel=1",
    "lint": "pnpm exec nx run-many -t lint --parallel=1",
    "lint:fix": "pnpm exec nx run-many -t lint --fix --parallel=1",
    "lint:one-by-one": "pnpm exec nx run-many -t lint --parallel=1",
    "lint:fix:one-by-one": "pnpm exec nx run-many -t lint --fix --parallel=1",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "audit:full": "pnpm purge:emissions:ci && pnpm audit:workspace && pnpm format:write && pnpm lint:fix:one-by-one && pnpm weaver:build && pnpm typecheck && pnpm test:unit",
    "audit:full:cloud": "pnpm audit:full && pnpm audit:infrastructure",
    "audit:infrastructure": "tsx --tsconfig ./tsconfig.base.json scripts/src/audit-cloud-infrastructure-secrets.ts",
    "audit:infrastructure:advisory": "pnpm audit:infrastructure || node -e \"console.warn('[SRE_ADVISORY]: Sonda cloud reporto advertencia; revisar matriz anterior en logs.')\"",
    "audit:exceptions": "tsx --tsconfig ./tsconfig.base.json scripts/src/audit-exceptions.ts",
    "audit:workspace": "tsx --tsconfig ./tsconfig.base.json scripts/src/audit-workspace-conformance.ts",
    "// --- 📊 FINANCIAL & MUNICIPAL DATA INGESTION ---": "",
    "ingest:budget": "tsx --tsconfig ./tsconfig.base.json scripts/src/ingest-financial-budget.ts",
    "// --- 🧪 QA: FORENSIC TESTING ---": "",
    "test:unit": "pnpm exec nx run-many -t test",
    "test:e2e": "pnpm exec nx e2e floripa-dignidade-e2e",
    "// --- 🧹 WORKSPACE HYGIENE & MAINTENANCE ---": "",
    "purge:emissions": "tsx --tsconfig ./tsconfig.base.json scripts/src/purge-rogue-emissions.ts",
    "purge:emissions:ci": "tsx --tsconfig ./tsconfig.base.json scripts/src/purge-rogue-emissions.ts --ci",
    "workspace:clean": "pnpm exec nx reset && node -e \"['dist','.nx','tmp'].forEach(directoryPathLiteral => fs.rmSync(directoryPathLiteral, { recursive: true, force: true }))\"",
    "workspace:graph": "pnpm exec nx graph",
    "// --- 🪝 GIT HOOKS: QUALITY SHIELD ---": "",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-s3": "^3.84.1",
    "@payloadcms/translations": "^3.84.1",
    "@payloadcms/ui": "^3.84.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-query-persist-client": "^5.100.10",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "fuse.js": "^7.3.0",
    "graphql": "^16.13.2",
    "graphql-tag": "^2.12.6",
    "lucide-react": "^1.70.0",
    "next": "~16.1.7",
    "payload": "^3.84.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.73.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.1.7",
    "@nx/devkit": "22.6.5",
    "@nx/eslint": "22.6.5",
    "@nx/eslint-plugin": "22.6.5",
    "@nx/jest": "22.6.5",
    "@nx/js": "22.6.5",
    "@nx/next": "22.6.5",
    "@nx/playwright": "22.6.5",
    "@nx/react": "^22.6.5",
    "@nx/workspace": "22.6.5",
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.0",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "~0.2.38",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/parser": "^8.59.0",
    "autoprefixer": "10.4.13",
    "babel-jest": "^30.0.2",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.7",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.2",
    "jest-environment-jsdom": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^17.6.0",
    "nx": "22.6.5",
    "postcss": "8.4.38",
    "postcss-load-config": "^6.0.1",
    "prettier": "~3.6.2",
    "tailwindcss": "3.4.3",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "packageManager": "pnpm@10.26.1+sha512.664074abc367d2c9324fdc18037097ce0a8f126034160f709928e9e9f95d98714347044e5c3164d65bd5da6c59c6be362b107546292a8eecb7999196e5ce58fa",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  }
}
