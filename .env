# ====================================================================================
# FLORIPA DIGNIDADE: SOVEREIGN ENVIRONMENT MANIFEST (Zenith V17.0)
# ====================================================================================

# --- 1. CMS INFRASTRUCTURE (Payload 3.0 / Content Manager) ---
# Secreto inmutable para la firma de sesiones administrativas
PAYLOAD_SECRET="fbe5e010f836e7df9555e7d46f0272696a8a3ba0acf1e106edbfd4633613d551"
# URL absoluta de la instancia (Sincronizada con el despliegue Vercel)
NEXT_PUBLIC_SITE_URL=https://floripa-dignidade.vercel.app

# --- 2. CLOUD SOVEREIGN PERSISTENCE (Supabase / Postgres) ---
# Cadena de conexión física para el motor de base de datos
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# Puntos de enlace REST para el enjambre de servicios
SUPABASE_URL=https://[YOUR_PROJECT_ID].supabase.co
# Token de alta autoridad para operaciones de escritura (Service Role)
SUPABASE_SERVICE_ROLE_KEY=[SECRET_KEY]

# --- 3. STORAGE GATEWAY (S3-Compatible / Supabase Storage) ---
S3_ENDPOINT=https://[YOUR_PROJECT_ID].supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=[KEY_ID]
S3_SECRET_ACCESS_KEY=[SECRET_KEY]
S3_REGION=us-east-1
S3_BUCKET=media-vault

# --- 4. COMUNICACIÓN INSTITUCIONAL (Resend) ---
RESEND_API_KEY=re_[SECRET_KEY]
RESEND_FROM_EMAIL=transparencia@floripa-dignidade.org

# --- 5. WHATSAPP GATEWAY (Meta Integration) ---
WHATSAPP_VERIFY_TOKEN=[SOVEREIGN_RANDOM_STRING]
WHATSAPP_APP_SECRET=[HMAC_SHA256_SECRET]

# --- 6. NEURAL SENTINEL (IA Cognitive Brain - Hugging Face) ---
HUGGING_FACE_API_TOKEN=hf_[SECRET_TOKEN]
HUGGING_FACE_MODEL_URL=https://api-inference.huggingface.co/models/meta-llama/Meta-Llama-3-8B-Instruct

# --- 7. SRE SECURITY & INFRASTRUCTURE ---
# Token de emergencia para auditoría física y bypass de seguridad
SOVEREIGN_EMERGENCY_TOKEN=[LONG_RANDOM_STRING]
# Entorno nominal (production | development)
NODE_ENV=production
# Token de Nx Cloud para auditoría de Grafo y caché distribuida
NX_CLOUD_ACCESS_TOKEN=[TOKEN]
