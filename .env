# ==============================================================================
# 🧠 MATRIZ MULTI-MODELO DE INTELIGENCIA ARTIFICIAL (BI-HEMISFÉRICA)
# ==============================================================================

# --- 1. GOOGLE GEMINI (Primario para Razonamiento Rápido, Visión y Contexto Masivo) ---
# Modelos: gemini-2.0-flash, gemini-1.5-pro
GEMINI_API_KEY=AIzaSyD...
GEMINI_FALLBACK_API_KEY=AIzaSyB...

# --- 2. ANTHROPIC CLAUDE (Especialista en Refactorización, Código e Inspección Forense) ---
# Modelos: claude-3-5-sonnet-latest, claude-3-5-haiku-latest
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- 3. OPENAI (Fallback Global y Embeddings Vectoriales) ---
# Modelos: gpt-4o, gpt-4o-mini, text-embedding-3-small
OPENAI_API_KEY=sk-proj-...

# --- 4. GROQ CLOUD (Inferencia Sub-Milisegundo para Respuestas al Ciudadano) ---
# Modelos: llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b
GROQ_API_KEY=gsk_...

# --- 5. DEEPSEEK (Razonamiento Lógico Profundo de Bajo Costo) ---
# Modelos: deepseek-chat, deepseek-reasoner
DEEPSEEK_API_KEY=sk-...

# --- 6. HUGGING FACE SPACES (Inferencia Soberana / Datos Críticos de DDHH) ---
HUGGING_FACE_API_TOKEN=hf_...
HUGGING_FACE_MODEL_URL=https://api-inference.huggingface.co/models/meta-llama/Meta-Llama-3-8B-Instruct

# --- 🛡️ GOBERNANZA DE LLAVES Y SEGURIDAD CRIPTOGRÁFICA DE IA ---
# Salt utilizado para generar el SHA-256 de las API keys en telemetría
AI_KEYS_INTEGRITY_SALT=floripa_dignidade_ai_salt_entropy_vector_2026

# --- ⚙️ POLÍTICAS DEL ENJAMBRE DE ENRUTAMIENTO (COGNITIVE ROUTER) ---
# Estrategias: LOWEST_LATENCY | LOWEST_COST | HIGHEST_REASONING | PRIVACY_SOVEREIGN
AI_SENTINEL_ROUTING_STRATEGY=HIGHEST_REASONING
AI_CIVIC_ROUTING_STRATEGY=LOWEST_LATENCY
AI_CIRCUIT_BREAKER_MAX_FAILURES=3
AI_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000
AI_EXECUTION_SANDBOX_ENABLED=true
