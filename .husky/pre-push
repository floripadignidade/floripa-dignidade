#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Si estamos en un entorno de integración continua o Vercel, forzar validación rigurosa
if [ "$CI" = "true" ] || [ -n "$VERCEL" ]; then
  echo "--- [CI SENTRY]: Ejecutando pre-flight riguroso en servidor ---"
  pnpm preflight
else
  echo "--- [DEVELOPER SENTRY]: Entorno local detectado. Omitiendo pre-push pesado ---"
  exit 0
fi
