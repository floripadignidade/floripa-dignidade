#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Si estamos en CI o Vercel, exigir Conventional Commits riguroso
if [ "$CI" = "true" ] || [ -n "$VERCEL" ]; then
  pnpm exec commitlint --edit "$1"
else
  # En desarrollo local omitimos el bloqueo estricto de commitlint para permitirte
  # escribir commits libres (ej. "wip", "test", etc.) sin frustración.
  exit 0
fi
