/**
 * @section Quality Assurance - Spec Compiler Infrastructure (QA Mirror)
 * @description Manifiesto de verificación de tipos para archivos de prueba unitaria y de integración (.spec.ts).
 * Rige bajo la doctrina Source-First (OEDP-V18.1), consumiendo directamente el código fuente
 * de las librerías del monorepo a través del mapa de rutas unificado de tsconfig.base.json
 * sin sobreingeniería de proyectos compuestos, emisión intermedia, baseUrl ni referencias a dist.
 *
 * Protocolo OEDP-V18.1 - Reference Architecture (Source-First).
 * Normas: ISO/IEC 11179 (Nomenclatura Prosa) e ISO/IEC 25010 (Mantenibilidad y Rendimiento).
 * SANEADO Zenith: Erradicación definitiva de baseUrl (ADR 0018), purga de punteros hacia
 * dist/out-tsc (Fix TS2307), alineación al estándar noEmit: true y soporte JSX para React 19.
 *
 * @author Raz Podestá - MetaShark Tech
 * @license UNLICENSED
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc/tests-spec",

    /* --- ESTRATEGIA SOURCE-FIRST: Auditoría de Fuentes Pura --- */
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,

    /* --- INTEGRIDAD DE RESOLUCIÓN (Standard Next-Gen) --- */
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- RIGOR DE IDENTIDAD (SRE Compliance) --- */
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",

    /* --- ADN DEL ENTORNO DE PRUEBAS --- */
    "types": ["jest", "node", "react", "react-dom", "@testing-library/jest-dom"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },

  "include": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "src/**/*.d.ts"],

  "exclude": ["node_modules", "dist", "out-tsc", "../dist", "../node_modules"],

  "references": []
}
