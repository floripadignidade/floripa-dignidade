{
  "name": "@floripa-dignidade/qa-mirror",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tests/src",
  "projectType": "library",
  "tags": ["scope:qa", "type:tool", "platform:isomorphic"],
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "cache": true,
      "options": {
        "outputPath": "dist/out-tsc/tests",
        "main": "tests/src/index.ts",
        "tsConfig": "tests/tsconfig.lib.json",
        "stripLeadingPaths": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/out-tsc/tests"],
      "options": {
        "command": "tsc -p tests/tsconfig.lib.json",
        "color": true
      },
      "cache": true
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/tests/qa-mirror"],
      "cache": true,
      "options": {
        "jestConfig": "tests/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "cache": true,
      "options": {
        "lintFilePatterns": ["tests/**/*.ts", "tests/**/*.tsx"]
      }
    }
  }
}
