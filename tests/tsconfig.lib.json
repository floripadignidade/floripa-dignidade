/**
 * @section tscheck: Emitter (QA Mirror Bunker)
 * @description Generador de ADN para el búnker de aserción. Orquesta la
 * validación de pruebas mediante la Redirección de ADN Maestro.
 *
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Resolución de TS6059 mediante la anulación de la lista de
 * archivos heredada del Gatekeeper, protegiendo la integridad del rootDir.
 *
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH (Flattened Output) --- */
    "outDir": "../dist/out-tsc/tests",
    "tsBuildInfoFile": "../dist/out-tsc/tests/tsconfig.lib.tsbuildinfo",

    /* --- INTEGRIDAD SOBERANA (ADN Emitter) --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,

    /**
     * 🛡️ LEY ZENITH: rootDir apunta estrictamente a 'src'.
     * Para evitar el error TS6059, este archivo DEBE sobreescribir la
     * propiedad "files" heredada con un array vacío.
     */
    "rootDir": "src",

    /* --- REDIRECCIÓN DE ADN MAESTRO (Consumo de CI) --- */
    "baseUrl": ".",
    "paths": {
      "@floripa-dignidade/exceptions": ["../dist/out-tsc/libs/core/exceptions/index.d.ts"],
      "@floripa-dignidade/telemetry": ["../dist/out-tsc/libs/core/telemetry/index.d.ts"],
      "@floripa-dignidade/environment-validator": [
        "../dist/out-tsc/libs/core/environment-validator/index.d.ts"
      ]
    },

    /* --- RESOLUCIÓN NEXT-GEN (Bundler & Isolated) --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO DE PRUEBAS --- */
    "types": ["node", "jest"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },

  /**
   * 🛡️ SOLUCIÓN MAESTRA AL ERROR TS6059:
   * Al declarar "files" como un array vacío, obligamos al compilador a
   * ignorar 'jest.config.ts' (que reside en la raíz) durante la emisión
   * de tipos, limitándose exclusivamente al patrón definido en "include".
   */
  "files": [],

  "include": ["src/**/*.ts", "src/**/*.tsx"],

  "exclude": ["node_modules", "dist", "out-tsc", "../dist", "../node_modules"],

  /**
   * @section Grafo de Referencias Soberanas
   */
  "references": []
}
