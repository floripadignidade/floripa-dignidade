{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc/tests",
    "tsBuildInfoFile": "../dist/out-tsc/tests/tsconfig.lib.tsbuildinfo",

    /* --- Integridad Soberana (QA Verifier) --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "noEmit": false,

    /* --- Redirección de ADN (Source-First Strategy) --- */
    "baseUrl": ".",
    "paths": {
      /* 🛡️ CORRECCIÓN: Rutas relativas exactas desde la carpeta /tests */
      "@floripa-dignidade/exceptions": ["../libs/core/exceptions/src/index.ts"],
      "@floripa-dignidade/telemetry": ["../libs/core/telemetry/src/index.ts"]
    },

    /* --- Resolución Zenith Standard --- */
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- Gobernanza de Renderizado --- */
    "jsx": "react-jsx",

    /* --- ADN del Entorno --- */
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts", "src/**/*.spec.tsx", "src/**/*.test.ts"],
  "references": [
    {
      "path": "../libs/core/exceptions/tsconfig.lib.json"
    }
  ]
}
