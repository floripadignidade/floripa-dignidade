/**
 * @section tscheck: Emitter (QA Mirror Bunker)
 * @description Generador de ADN para el búnker de aserción. Orquesta la
 * validación de pruebas mediante la Redirección de ADN Maestro.
 *
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Alineación de rootDir y blindaje de jurisdicción para CI.
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH --- */
    "outDir": "../dist/out-tsc/tests",
    "tsBuildInfoFile": "../dist/out-tsc/tests/tsconfig.lib.tsbuildinfo",

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,

    /** 🛡️ LEY ZENITH: rootDir apunta al búnker para incluir specs en la validación */
    "rootDir": ".",
    "noEmit": false,

    /* --- REDIRECCIÓN DE ADN MAESTRO (Consumo de CI) --- */
    "baseUrl": ".",
    "paths": {
      "@floripa-dignidade/exceptions": ["../dist/out-tsc/libs/core/exceptions/index.d.ts"],
      "@floripa-dignidade/telemetry": ["../dist/out-tsc/libs/core/telemetry/index.d.ts"],
      "@floripa-dignidade/environment-validator": ["../dist/out-tsc/libs/core/environment-validator/index.d.ts"]
    },

    "module": "Preserve",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "types": ["node", "jest"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "jest.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "out-tsc",
    "../dist",
    "../node_modules"
  ],

  "references": [
    { "path": "../libs/core/exceptions/tsconfig.lib.json" },
    { "path": "../libs/core/telemetry/tsconfig.lib.json" },
    { "path": "../libs/core/environment-validator/tsconfig.lib.json" }
  ]
}
