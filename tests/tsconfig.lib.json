/**
 * @section tscheck: Emitter (QA Mirror Bunker)
 * @description Generador de ADN para el búnker de aserción. Orquesta la
 * validación de pruebas mediante la Redirección de ADN Maestro.
 *
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Alineación de rootDir, erradicación de TS6059 (Hemorragia de Fronteras)
 * y blindaje de jurisdicción aislando los artefactos de configuración.
 *
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH --- */
    "outDir": "../dist/out-tsc/tests",
    "tsBuildInfoFile": "../dist/out-tsc/tests/tsconfig.lib.tsbuildinfo",

    /* --- INTEGRIDAD SOBERANA (ADN Emitter) --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,

    /**
     * 🛡️ LEY ZENITH: rootDir apunta estrictamente a 'src'.
     * Los archivos de configuración de raíz (.js/.ts) están prohibidos en esta emisión.
     */
    "rootDir": "src",

    /* --- REDIRECCIÓN DE ADN MAESTRO (Consumo de CI) --- */
    "baseUrl": ".",
    "paths": {
      "@floripa-dignidade/exceptions": ["../dist/out-tsc/libs/core/exceptions/index.d.ts"],
      "@floripa-dignidade/telemetry": ["../dist/out-tsc/libs/core/telemetry/index.d.ts"],
      "@floripa-dignidade/environment-validator": ["../dist/out-tsc/libs/core/environment-validator/index.d.ts"]
    },

    /* --- RESOLUCIÓN NEXT-GEN --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO DE PRUEBAS --- */
    "types": ["node", "jest"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "out-tsc",
    "../dist",
    "../node_modules"
  ],

  /**
   * @section Grafo de Referencias Soberanas
   */
  "references": [
    { "path": "../libs/core/exceptions/tsconfig.lib.json" },
    { "path": "../libs/core/telemetry/tsconfig.lib.json" },
    { "path": "../libs/core/environment-validator/tsconfig.lib.json" }
  ]
}
