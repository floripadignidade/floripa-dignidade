/**
 * @section Quality Assurance - Compiler Infrastructure (QA Mirror)
 * @description Manifiesto de verificación de tipos para la biblioteca de pruebas espejo del monorepo.
 * Rige bajo la doctrina Source-First (OEDP-V18.1), consumiendo directamente el código fuente
 * de las librerías a través del mapa de rutas unificado de tsconfig.base.json sin sobreingeniería
 * de proyectos compuestos, emisión intermedia ni referencias a dist.
 *
 * Protocolo OEDP-V18.1 - Reference Architecture (Source-First).
 * Normas: ISO/IEC 11179 (Nomenclatura Prosa) e ISO/IEC 25010 (Mantenibilidad y Rendimiento).
 * SANEADO Zenith: Erradicación del arreglo vacío 'files' redundante, inyección de target ES2022,
 * soporte para JSX React 19 y aseguramiento de tipado estricto para Jest y Testing Library.
 *
 * @author Raz Podestá - MetaShark Tech
 * @license UNLICENSED
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc/tests",

    /* --- ESTRATEGIA SOURCE-FIRST: Auditoría de Fuentes Pura --- */
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,

    /* --- INTEGRIDAD DE RESOLUCIÓN (Standard Next-Gen) --- */
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- RIGOR DE IDENTIDAD (SRE Compliance) --- */
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",

    /* --- ADN DEL ENTORNO DE PRUEBAS --- */
    "types": ["node", "jest", "@testing-library/jest-dom"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "out-tsc",
    "../dist",
    "../node_modules"
  ],

  "references": []
}