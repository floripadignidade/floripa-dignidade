/**
 * @section tscheck: Emitter (QA Mirror Bunker)
 * @description Generador de ADN para el búnker de aserción. Orquesta la
 * validación de pruebas mediante la Redirección de ADN Maestro.
 *
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Resolución de conflicto 'rootDir' y supresión de deprecaciones.
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH (Flattened Output) --- */
    "outDir": "../dist/out-tsc/tests",
    "tsBuildInfoFile": "../dist/out-tsc/tests/tsconfig.lib.tsbuildinfo",

    /* --- INTEGRIDAD SOBERANA (ADN Emitter) --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    /**
     * 🛡️ SANEADO Zenith: Alineamos rootDir con la raíz del búnker '.' para
     * permitir que el Gatekeeper valide archivos de configuración (jest)
     * sin violar la jurisdicción de fuentes.
     */
    "rootDir": ".",
    "noEmit": false,

    /* --- RIGOR DE IDENTIDAD (SRE Compatibility) --- */
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",

    /* --- REDIRECCIÓN DE ADN MAESTRO (Fix Performance) --- */
    /**
     * 🛡️ LEY DEL ENJAMBRE: El búnker de pruebas consume el ADN físico
     * desde 'dist/out-tsc' en lugar de los fuentes, acelerando el typecheck.
     */
    "paths": {
      "@floripa-dignidade/exceptions": ["../dist/out-tsc/libs/core/exceptions/index.d.ts"],
      "@floripa-dignidade/telemetry": ["../dist/out-tsc/libs/core/telemetry/index.d.ts"],
      "@floripa-dignidade/environment-validator": ["../dist/out-tsc/libs/core/environment-validator/index.d.ts"]
    },

    /* --- RESOLUCIÓN NEXT-GEN --- */
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO (Test Context) --- */
    "types": ["node", "jest"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "out-tsc",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],

  /**
   * @section Grafo de Referencias Soberanas
   */
  "references": [
    {
      "path": "../libs/core/exceptions/tsconfig.lib.json"
    },
    {
      "path": "../libs/core/telemetry/tsconfig.lib.json"
    }
  ]
}
