/**
 * @section Search Engine - Compiler Infrastructure
 * @description Manifiesto de verificación de tipos para el motor de búsqueda difusa.
 * Implementa la doctrina Source-First (OEDP-V18.1), consumiendo dependencias directamente
 * desde las fuentes TypeScript y permitiendo la resolución natural de dependencias externas.
 *
 * Protocolo OEDP-V18.1 - Reference Architecture (Source-First).
 * SANEADO Zenith: Erradicación definitiva del colapso interno 'Debug Failure' de TypeScript 5.9
 * purgando el mapeo artificial de 'fuse.js' a '.d.ts' y alineando el compilador a modo 'noEmit'.
 *
 * @author Raz Podestá - MetaShark Tech
 * @license UNLICENSED
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc/libs/engines/search-engine",

    /* --- ESTRATEGIA SOURCE-FIRST: Cero Sobreingeniería --- */
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,

    /* --- INTEGRIDAD DE RESOLUCIÓN (Standard Next-Gen) --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- RIGOR DE IDENTIDAD (SRE Compliance) --- */
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,

    /* --- ADN DEL ENTORNO --- */
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../../dist",
    "../../../node_modules"
  ],
  "references": []
}
