/**
 * @section tsconfig: Emitter (Impact Analytics Engine)
 * @description Generador de ADN (.d.ts) con redirección física de Grafo.
 * Orquesta la emisión de tipos para el cerebro estadístico, garantizando
 * el aislamiento total de los dominios de negocio (ADR 0003).
 *
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Erradicación de dependencia ilegal sobre 'reputation-engine'.
 *
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH (Flattened Output) --- */
    "outDir": "../../../dist/out-tsc/libs/engines/impact-analytics-engine",
    "tsBuildInfoFile": "../../../dist/out-tsc/libs/engines/impact-analytics-engine/tsconfig.lib.tsbuildinfo",

    /* --- INTEGRIDAD SOBERANA (ADN Emitter) --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "noEmit": false,
    "importHelpers": true,
    "ignoreDeprecations": "5.0",

    /* --- REDIRECCIÓN DE ADN MAESTRO (Fix TS6059 / TS6305) --- */
    /**
     * 🛡️ LEY DEL ENJAMBRE: El motor consume solo infraestructura CORE.
     * Se elimina el acceso a la capa de MODULES para preservar la pureza algorítmica.
     */
    "baseUrl": ".",
    "paths": {
      "@floripa-dignidade/telemetry": ["../../../dist/out-tsc/libs/core/telemetry/index.d.ts"],
      "@floripa-dignidade/exceptions": ["../../../dist/out-tsc/libs/core/exceptions/index.d.ts"],
      "@floripa-dignidade/environment-validator": [
        "../../../dist/out-tsc/libs/core/environment-validator/index.d.ts"
      ]
    },

    /* --- RESOLUCIÓN NEXT-GEN (Alineación Next.js 16+) --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO (Isomorphic Math Context) --- */
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },

  "include": ["src/**/*.ts", "src/**/*.json"],

  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../../dist",
    "../../../node_modules"
  ],

  /**
   * @section Grafo de Referencias Soberanas
   * Mantiene el vínculo físico exclusivamente con la capa inferior (CORE).
   */
  "references": [
    {
      "path": "../../modules/reputation-engine/tsconfig.lib.json"
    },
    {
      "path": "../../core/environment-validator/tsconfig.lib.json"
    }
  ]
}
