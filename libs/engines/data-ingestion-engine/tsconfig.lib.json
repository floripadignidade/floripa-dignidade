/**
 * @section Compiler Infrastructure - Library Configuration
 * @description Manifiesto de verificación de tipos para el motor de ingestión de datos abiertos.
 * Implementa la doctrina Source-First (OEDP-V18.1): erradica baseUrl, desactiva la emisión
 * física de código y resuelve los tipos institucionales directamente desde las fuentes TypeScript
 * a través de la herencia canónica de tsconfig.base.json.
 *
 * Protocolo OEDP-V18.1 - Reference Architecture (Source-First).
 * Normas: ISO/IEC 11179 (Nomenclatura Prosa) e ISO/IEC 25010 (Mantenibilidad).
 *
 * @author Raz Podestá - MetaShark Tech
 * @license UNLICENSED
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc/libs/engines/data-ingestion-engine",

    /* --- ESTRATEGIA SOURCE-FIRST: Auditoría de Fuentes Pura --- */
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,

    /* --- INTEGRIDAD DE RESOLUCIÓN (Standard Next-Gen) --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- RIGOR DE IDENTIDAD (SRE Compliance) --- */
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,

    /* --- CONTEXTO DE EJECUCIÓN ISOMÓRFICO --- */
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../../dist",
    "../../../node_modules"
  ],
  "references": [
    {
      "path": "../../contracts"
    }
  ]
}
