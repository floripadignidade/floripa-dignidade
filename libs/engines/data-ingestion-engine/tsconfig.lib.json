// libs/engines/data-ingestion-engine/tsconfig.lib.json
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc/libs/engines/data-ingestion-engine",

    /* --- ESTRATEGIA SOURCE-FIRST: Auditoría de Fuentes Pura --- */
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,

    /* --- INTEGRIDAD DE RESOLUCIÓN (Standard Next-Gen) --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- RIGOR DE IDENTIDAD (SRE Compliance) --- */
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,

    /* --- CONTEXTO DE EJECUCIÓN ISOMÓRFICO --- */
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../../dist",
    "../../../node_modules"
  ],
  "references": []
}
