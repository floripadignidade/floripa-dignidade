/**
 * @section tsconfig: Emitter (Financial Ingestion Engine)
 * @description Generador de ADN (.d.ts) con redirección física de Grafo.
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Mapeo de soberanía para 'exceljs' y resolución de TS7016.
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc/libs/engines/financial-ingestion-engine",
    "tsBuildInfoFile": "../../../dist/out-tsc/libs/engines/financial-ingestion-engine/tsconfig.lib.tsbuildinfo",

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "noEmit": false,
    "importHelpers": true,
    "ignoreDeprecations": "5.0",

    "baseUrl": ".",
    "paths": {
      /* 🛡️ LEY DEL ENJAMBRE: Redirección de ADN Core */
      "@floripa-dignidade/telemetry": ["../../../dist/out-tsc/libs/core/telemetry/index.d.ts"],
      "@floripa-dignidade/exceptions": ["../../../dist/out-tsc/libs/core/exceptions/index.d.ts"],
      "@floripa-dignidade/environment-validator": [
        "../../../dist/out-tsc/libs/core/environment-validator/index.d.ts"
      ],

      /* 🛡️ MAPEO DE SOBERANÍA: Bypass para la resolución de ExcelJS */
      "exceljs": ["src/index.d.ts"]
    },

    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "types": ["node"],
    "lib": ["ES2022"]
  },
  "include": ["src/**/*.ts", "src/**/*.json", "src/index.d.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../../dist",
    "../../../node_modules"
  ],
  "references": [
    {
      "path": "../../core/environment-validator/tsconfig.lib.json"
    }
  ]
}
