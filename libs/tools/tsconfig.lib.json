/**
 * @section tsconfig: Emitter (Tools & Automation)
 * @description Generador de ADN (.d.ts) para procesos de automatización.
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Erradicación de TS2307 y TS6059 mediante la herencia
 * del Grafo Maestro. Eliminamos 'rootDir' y 'paths' para permitir que el
 * compilador consuma fuentes (.ts) si las firmas físicas aún no existen,
 * habilitando la resiliencia de compilación en Vercel.
 *
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH (Jurisdicción Física) --- */
    "outDir": "../../dist/out-tsc/libs/tools",
    "tsBuildInfoFile": "../../dist/out-tsc/libs/tools/tsconfig.lib.tsbuildinfo",

    /* --- INTEGRIDAD SOBERANA (ADN Emitter) --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "importHelpers": true,
    "ignoreDeprecations": "5.0",

    /* --- RESOLUCIÓN NEXT-GEN (Bundler Ready) --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO (Node.js Scripting) --- */
    "types": ["node"],
    "lib": ["ES2022"]
  },

  "include": ["src/**/*.ts"],

  "exclude": [
    /* 🛡️ LIMPIEZA DE JURISDICCIÓN */
    "src/**/*.spec.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../dist",
    "../../node_modules"
  ],

  /**
   * @section Grafo de Referencias Soberanas
   */
  "references": [
    { "path": "../core/exceptions/tsconfig.lib.json" },
    { "path": "../core/telemetry/tsconfig.lib.json" },
    { "path": "../engines/financial-ingestion-engine/tsconfig.lib.json" }
  ]
}
