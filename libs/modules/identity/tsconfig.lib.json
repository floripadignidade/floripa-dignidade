/**
 * @section tsconfig: Emitter (Identity IAM)
 * @description Generador de ADN (.d.ts) con redirección física de Grafo.
 * Orquesta la emisión de tipos para el Juez de Paz del ecosistema, permitiendo
 * que la soberanía de identidad sea consumida de forma Type-Safe por el enjambre.
 *
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH (Flattened Output) --- */
    "outDir": "../../../dist/out-tsc/libs/modules/identity",
    "tsBuildInfoFile": "../../../dist/out-tsc/libs/modules/identity/tsconfig.lib.tsbuildinfo",

    /* --- INTEGRIDAD SOBERANA (ADN Emitter) --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "noEmit": false,
    "importHelpers": true,
    "ignoreDeprecations": "5.0",

    /* --- REDIRECCIÓN DE ADN MAESTRO (Fix TS6059 / TS6305) --- */
    "baseUrl": ".",
    "paths": {
      "@floripa-dignidade/exceptions": ["../../../dist/out-tsc/libs/core/exceptions/index.d.ts"],
      "@floripa-dignidade/telemetry": ["../../../dist/out-tsc/libs/core/telemetry/index.d.ts"],
      "@floripa-dignidade/environment-validator": ["../../../dist/out-tsc/libs/core/environment-validator/index.d.ts"]
    },

    /* --- RESOLUCIÓN NEXT-GEN (Alineación Next.js 16+) --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO (Isomorphic Identity Context) --- */
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },

  "include": ["src/**/*.ts", "src/**/*.json"],

  "exclude": [
    /* 🛡️ LIMPIEZA DE JURISDICCIÓN: Evitamos fugas de rastro técnico en la emisión */
    "src/**/*.spec.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../../dist",
    "../../../node_modules"
  ],

  /**
   * @section Grafo de Referencias Soberanas
   * Establece el vínculo físico con los búnkeres CORE de los que depende el IAM.
   */
  "references": [
    { "path": "../../core/exceptions/tsconfig.lib.json" },
    { "path": "../../core/telemetry/tsconfig.lib.json" },
    { "path": "../../core/environment-validator/tsconfig.lib.json" }
  ]
}
