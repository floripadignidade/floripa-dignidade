// libs/modules/identity/tsconfig.lib.json

/**
 * @section User Management & Identity - Compiler Infrastructure
 * @description Manifiesto de verificación de tipos para el módulo de identidad y acceso institucional.
 * Rige bajo la doctrina Source-First (OEDP-V18.1), consumiendo directamente el código fuente
 * de las librerías del monorepo a través del mapa de rutas unificado de tsconfig.base.json
 * sin sobreingeniería de proyectos compuestos ni bloqueos de emisión.
 *
 * Protocolo OEDP-V18.1 - Reference Architecture (Source-First).
 * Normas: ISO/IEC 11179 (Nomenclatura Prosa) e ISO/IEC 25010 (Mantenibilidad y Seguridad).
 *
 * @author Raz Podestá - MetaShark Tech
 * @license UNLICENSED
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc/libs/modules/identity",

    /* --- ESTRATEGIA SOURCE-FIRST: Auditoría de Fuentes Pura --- */
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,

    /* --- INTEGRIDAD DE RESOLUCIÓN (Standard Next-Gen) --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- RIGOR DE IDENTIDAD (SRE Compliance) --- */
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,

    /* --- CONTEXTO DE EJECUCIÓN ISOMÓRFICO --- */
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },

  "include": ["src/**/*.ts"],

  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "node_modules",
    "dist",
    "out-tsc",
    "../../../dist"
  ],
  "references": [
    {
      "path": "../../contracts"
    }
  ]
}
