/**
 * @section User Management & Identity - Compiler Infrastructure
 * @description Manifiesto de validación para el motor de tipos del búnker de identidad.
 * Implementa la doctrina OEDP-V18.1: eliminación de restricciones de rootDir
 * para permitir la resolución nativa de dependencias cruzadas entre búnkeres.
 *
 * Protocolo OEDP-V18.1 - Reference Architecture (Source-First).
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc/libs/modules/identity",

    /* --- ESTRATEGIA ZENITH: Cero Sobreingeniería --- */
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,

    /* --- INTEGRIDAD DE RESOLUCIÓN (Standard Next-Gen) --- */
    /**
     * 🛡️ SOLUCIÓN TS6059: Se elimina 'rootDir: src'.
     * El compilador ahora utiliza la base del monorepo como punto de anclaje,
     * permitiendo la visibilidad de los paths definidos en tsconfig.base.json.
     */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- RIGOR DE IDENTIDAD (SRE Compliance) --- */
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,

    /* --- ADN DEL ENTORNO (Isomorphic Identity Context) --- */
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },

  "include": ["src/**/*.ts"],

  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "node_modules",
    "dist",
    "out-tsc",
    "../../../dist"
  ],
  "references": [
    {
      "path": "../../shared/utility/tsconfig.lib.json"
    },
    {
      "path": "../../contracts"
    },
    {
      "path": "../../core/environment-validator/tsconfig.lib.json"
    }
  ]
}
