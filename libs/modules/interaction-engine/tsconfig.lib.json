/**
 * @section Interaction Engine - Library Compiler Infrastructure
 * @description Manifiesto de verificación de tipos para el motor de interacciones, apoyos ciudadanos y sentimiento social.
 * Rige bajo la doctrina Source-First (OEDP-V18.1), consumiendo dependencias directamente
 * desde las fuentes TypeScript a través del mapa de rutas institucional de tsconfig.base.json
 * sin sobreingeniería de proyectos compuestos, emisión intermedia ni referencias a dist.
 *
 * Protocolo OEDP-V18.1 - Reference Architecture (Source-First).
 * Normas: ISO/IEC 11179 (Nomenclatura Prosa) e ISO/IEC 25010 (Mantenibilidad y Rendimiento).
 * SANEADO: Erradicación definitiva de referencias compuestas (Fix TS6306/TS6310),
 * inyección de banderas deterministas y soporte para React 19 JSX.
 *
 * @author Raz Podestá - MetaShark Tech
 * @license UNLICENSED
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc/libs/modules/interaction-engine",

    /* --- ESTRATEGIA SOURCE-FIRST: Auditoría de Fuentes Pura --- */
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,

    /* --- INTEGRIDAD DE RESOLUCIÓN (Standard Next-Gen) --- */
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- RIGOR DE IDENTIDAD (SRE Compliance) --- */
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,

    /* --- CONTEXTO DE EJECUCIÓN REACT 19 & DOM --- */
    "jsx": "react-jsx",
    "types": ["node", "react", "react-dom"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.json"
  ],

  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../../dist",
    "../../../node_modules"
  ],

  "references": []
}