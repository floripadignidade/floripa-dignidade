/**
 * @section tsconfig: Emitter
 * @description Generador de ADN (.d.ts) con redirección física de Grafo hacia dist.
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Inyección del puente de visibilidad hacia 'shared-utility'
 * para erradicar el colapso TS2307 y autorizar el PII Masking (LGPD).
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc/libs/modules/newsletter",
    "tsBuildInfoFile": "../../../dist/out-tsc/libs/modules/newsletter/tsconfig.lib.tsbuildinfo",

    /* --- Integridad Soberana --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "noEmit": false,
    "importHelpers": true,

    /* --- Redireccion de ADN (Solucion TS6059 / TS2307) --- */
    "paths": {
      "@floripa-dignidade/telemetry": ["../../../dist/out-tsc/libs/core/telemetry/index.d.ts"],
      "@floripa-dignidade/exceptions": ["../../../dist/out-tsc/libs/core/exceptions/index.d.ts"],
      "@floripa-dignidade/environment-validator": [
        "../../../dist/out-tsc/libs/core/environment-validator/index.d.ts"
      ],
      "@floripa-dignidade/resend-provider": [
        "../../../dist/out-tsc/libs/core/communication-providers/resend/index.d.ts"
      ],

      /* 🛡️ LEY DEL ENJAMBRE: Puente hacia el búnker de utilidades para privacidad */
      "@floripa-dignidade/shared-utility": ["../../../dist/out-tsc/libs/shared/utility/index.d.ts"]
    },

    /* --- Resolucion Next-Gen --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN del Entorno (Cloud-Native Context) --- */
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../../dist",
    "../../../node_modules"
  ],
  "references": [
    {
      "path": "../../shared/utility/tsconfig.lib.json"
    },
    {
      "path": "../../core/communication-providers/resend/tsconfig.lib.json"
    },
    {
      "path": "../../core/environment-validator/tsconfig.lib.json"
    }
  ]
}
