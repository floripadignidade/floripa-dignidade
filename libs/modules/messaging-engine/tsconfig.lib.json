/**
 * @section tsconfig: Emitter (Interaction Engine)
 * @description Generador de ADN (.d.ts) con redirección física de Grafo.
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Erradicación de la dependencia 'shared' obsoleta y
 * alineación con la fragmentación de utilidades, estado y UI.
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc/libs/modules/interaction-engine",
    "tsBuildInfoFile": "../../../dist/out-tsc/libs/modules/interaction-engine/tsconfig.lib.tsbuildinfo",

    /* --- Integridad Soberana (ADN Emitter) --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "noEmit": false,
    "importHelpers": true,
    "ignoreDeprecations": "5.0",

    /* --- REDIRECCIÓN DE ADN MAESTRO (Fix TS6059 / TS6305) --- */
    "baseUrl": ".",
    "paths": {
      "@floripa-dignidade/telemetry": ["../../../dist/out-tsc/libs/core/telemetry/index.d.ts"],
      "@floripa-dignidade/exceptions": ["../../../dist/out-tsc/libs/core/exceptions/index.d.ts"],
      "@floripa-dignidade/identity": ["../../../dist/out-tsc/libs/modules/identity/index.d.ts"],

      /* 🛡️ SANEADO: Redirección hacia los nuevos búnkeres fragmentados */
      "@floripa-dignidade/shared-utility": ["../../../dist/out-tsc/libs/shared/utility/index.d.ts"],
      "@floripa-dignidade/shared-state-store": ["../../../dist/out-tsc/libs/shared/state-store/index.d.ts"],
      "@floripa-dignidade/shared-ui-foundry": ["../../../dist/out-tsc/libs/shared/ui-foundry/index.d.ts"]
    },

    /* --- RESOLUCIÓN NEXT-GEN --- */
    "jsx": "react-jsx",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO --- */
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../../dist",
    "../../../node_modules"
  ],
  "references": [
    { "path": "../../core/telemetry/tsconfig.lib.json" },
    { "path": "../../core/exceptions/tsconfig.lib.json" },
    { "path": "../../modules/identity/tsconfig.lib.json" },

    /* 🛡️ SANEADO: Vínculos físicos de proyecto actualizados */
    { "path": "../../shared/utility/tsconfig.lib.json" },
    { "path": "../../shared/state-store/tsconfig.lib.json" },
    { "path": "../../shared/ui-foundry/tsconfig.lib.json" }
  ]
}
