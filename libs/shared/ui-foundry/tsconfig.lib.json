/**
 * @section Shared UI Foundry - DNA Emitter (Zenith Configuration)
 * @description Generador de firmas físicas (.d.ts) para la Fundición Visual.
 *
 * Protocolo OEDP-V17.0 - High Performance SRE & SOLID Infrastructure.
 * SANEADO Zenith: Erradicación de TS2307 (Asfixia de Identidad) y TS6059
 * mediante la herencia del Grafo Maestro. Eliminamos 'rootDir' y el bloque
 * 'paths' local para permitir que el compilador consuma fuentes (.ts) en
 * memoria durante despliegues CI/CD. Las firmas ambientales (lucide-react)
 * se procesan de forma nativa a través del archivo index.d.ts.
 *
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH (Flattened Output) --- */
    "outDir": "../../../dist/out-tsc/libs/shared/ui-foundry",
    "tsBuildInfoFile": "../../../dist/out-tsc/libs/shared/ui-foundry/tsconfig.lib.tsbuildinfo",

    /* --- INTEGRIDAD SOBERANA (ADN Emitter) --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "importHelpers": true,

    /* --- RESOLUCIÓN NEXT-GEN (Turbopack Ready) --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO (Visual Implementation Context) --- */
    "types": ["node", "react", "react-dom"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ],

  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../../dist",
    "../../../node_modules"
  ],

  /**
   * @section Grafo de Referencias Soberanas (SOLID Boundaries)
   */
  "references":[
    { "path": "../../core/telemetry/tsconfig.lib.json" },
    { "path": "../../core/exceptions/tsconfig.lib.json" },
    { "path": "../utility/tsconfig.lib.json" },
    { "path": "../state-store/tsconfig.lib.json" },
    { "path": "../design-system/tsconfig.lib.json" },
    { "path": "../ui-contracts/tsconfig.lib.json" }
  ]
}
