{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@floripa-dignidade/shared-ui-contracts": ["../ui-contracts/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "jest.config.ts", "dist", "node_modules"],
  "references": [
    {
      "path": "../utility/tsconfig.lib.json"
    },
    {
      "path": "../state-store/tsconfig.lib.json"
    }
  ]
}
