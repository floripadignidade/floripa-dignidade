/**
 * @section tsconfig: Emitter (UI Foundry)
 * @description Generador de ADN (.d.ts) con redirección física de Grafo.
 * Orquesta la emisión de tipos para la Fundición Visual, garantizando
 * que la UI consuma contratos inmutables de forma Type-Safe.
 *
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Inyección de Mapeo de Soberanía (Paths) para erradicar
 * TS2307 y TS7016, y blindaje SRE mediante skipLibCheck.
 *
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH --- */
    "outDir": "../../../dist/out-tsc/libs/shared/ui-foundry",
    "tsBuildInfoFile": "../../../dist/out-tsc/libs/shared/ui-foundry/tsconfig.lib.tsbuildinfo",

    /* --- INTEGRIDAD SOBERANA (ADN Emitter) --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "importHelpers": true,
    "ignoreDeprecations": "5.0",

    /* --- REDIRECCIÓN DE ADN MAESTRO (Fix TS2307) --- */
    "baseUrl": ".",
    "paths": {
      "@floripa-dignidade/telemetry":["../../../dist/out-tsc/libs/core/telemetry/index.d.ts"],
      "@floripa-dignidade/exceptions": ["../../../dist/out-tsc/libs/core/exceptions/index.d.ts"],
      "@floripa-dignidade/shared-design-system":["../../../dist/out-tsc/libs/shared/design-system/index.d.ts"],
      "@floripa-dignidade/shared-ui-contracts":["../../../dist/out-tsc/libs/shared/ui-contracts/index.d.ts"],
      "@floripa-dignidade/shared-utility":["../../../dist/out-tsc/libs/shared/utility/index.d.ts"],
      "@floripa-dignidade/shared-state-store":["../../../dist/out-tsc/libs/shared/state-store/index.d.ts"]
    },

    /* --- RESOLUCIÓN NEXT-GEN --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    /* --- ADN DEL ENTORNO --- */
    "types":["node", "react", "react-dom"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },

  "include":[
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ],

  "exclude":[
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../../dist",
    "../../../node_modules"
  ],

  /**
   * @section Grafo de Referencias Soberanas
   */
  "references":[
    { "path": "../../core/telemetry/tsconfig.lib.json" },
    { "path": "../../core/exceptions/tsconfig.lib.json" },
    { "path": "../utility/tsconfig.lib.json" },
    { "path": "../state-store/tsconfig.lib.json" },
    { "path": "../design-system/tsconfig.lib.json" },
    { "path": "../ui-contracts/tsconfig.lib.json" }
  ]
}
