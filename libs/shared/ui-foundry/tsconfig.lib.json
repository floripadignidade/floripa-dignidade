/**
 * @section Shared UI Foundry - DNA Emitter (Zenith Configuration)
 * @description Generador de firmas físicas (.d.ts) con redirección de Grafo.
 * Implementa el aislamiento total del rootDir mediante la Maniobra de Redirección.
 *
 * Protocolo OEDP-V17.0 - High Performance SRE & SOLID Infrastructure.
 * SANEADO Zenith: Erradicación de redundancia (DRY) y Mapeo de Soberanía.
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH (Flattened Output) --- */
    "outDir": "../../../dist/out-tsc/libs/shared/ui-foundry",
    "tsBuildInfoFile": "../../../dist/out-tsc/libs/shared/ui-foundry/tsconfig.lib.tsbuildinfo",

    /* --- INTEGRIDAD SOBERANA (ADN Emitter) --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "noEmit": false,
    "importHelpers": true,

    /** 🛡️ SANEADO Zenith: 'ignoreDeprecations' se hereda del Gatekeeper (DRY). */

    /* --- REDIRECCIÓN DE ADN MAESTRO (Fix TS6059 / TS6305) --- */
    "baseUrl": ".",
    "paths": {
      "@floripa-dignidade/telemetry": ["../../../dist/out-tsc/libs/core/telemetry/index.d.ts"],
      "@floripa-dignidade/exceptions": ["../../../dist/out-tsc/libs/core/exceptions/index.d.ts"],
      "@floripa-dignidade/shared-design-system": ["../../../dist/out-tsc/libs/shared/design-system/index.d.ts"],
      "@floripa-dignidade/shared-ui-contracts": ["../../../dist/out-tsc/libs/shared/ui-contracts/index.d.ts"],
      "@floripa-dignidade/shared-utility": ["../../../dist/out-tsc/libs/shared/utility/index.d.ts"],
      "@floripa-dignidade/shared-state-store": ["../../../dist/out-tsc/libs/shared/state-store/index.d.ts"],

      /**
       * 🛡️ MAPEO DE SOBERANÍA: Resolución de Asfixia de Identidad (Fix TS7016).
       */
      "lucide-react": ["src/index.d.ts"],
      "framer-motion": ["src/index.d.ts"],
      "next/link": ["src/index.d.ts"],
      "next/image": ["src/index.d.ts"],
      "next/navigation": ["src/index.d.ts"]
    },

    /* --- RESOLUCIÓN NEXT-GEN (Turbopack Ready) --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO (Visual Implementation Context) --- */
    "types": ["node", "react", "react-dom"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],

  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../../dist",
    "../../../node_modules"
  ],

  /**
   * @section Grafo de Referencias Soberanas (SOLID Boundaries)
   */
  "references": [
    { "path": "../../core/telemetry/tsconfig.lib.json" },
    { "path": "../../core/exceptions/tsconfig.lib.json" },
    { "path": "../utility/tsconfig.lib.json" },
    { "path": "../state-store/tsconfig.lib.json" },
    { "path": "../design-system/tsconfig.lib.json" },
    { "path": "../ui-contracts/tsconfig.lib.json" }
  ]
}
