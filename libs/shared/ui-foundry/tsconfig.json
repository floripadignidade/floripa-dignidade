/**
 * @section Shared UI Foundry - Configuration Gatekeeper
 * @description Orquestador de la frontera física del búnker de construcción visual (React 19).
 * Actúa como pasaporte de visibilidad e índice para el TypeScript Project Service y el IDE,
 * indexando directamente las fuentes bajo la doctrina Source-First (OEDP-V18.1).
 *
 * Protocolo OEDP-V18.1 - Reference Architecture (Source-First).
 * Normas: ISO/IEC 11179 (Nomenclatura Prosa) e ISO/IEC 25010 (Mantenibilidad).
 * SANEADO: Inclusión directa de fuentes (src/**\/*.ts, src/**\/*.tsx) para resolución de Project Service en ESLint.
 *
 * @author Raz Podestá - MetaShark Tech
 * @license UNLICENSED
 */
{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "ignoreDeprecations": "5.0"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "out-tsc"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
