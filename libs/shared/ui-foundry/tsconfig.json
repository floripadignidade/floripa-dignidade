/**
 * @section Shared UI Foundry - Configuration Gatekeeper
 * @description Orquestador de la frontera física del búnker de construcción visual (React 19).
 * Rige bajo la doctrina Source-First (OEDP-V18.1), indexando directamente las fuentes para
 * el TypeScript Project Service y el IDE, y erradicando referencias compuestas residuales
 * que provocan colisiones TS6306 y TS6310 con configuraciones noEmit: true.
 *
 * Protocolo OEDP-V18.1 - Reference Architecture (Source-First).
 * Normas: ISO/IEC 11179 (Nomenclatura Prosa) e ISO/IEC 25010 (Mantenibilidad y Estabilidad).
 *
 * @author Raz Podestá - MetaShark Tech
 * @license UNLICENSED
 */
{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "ignoreDeprecations": "5.0"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "out-tsc"],
  "references": []
}
