/**
 * @section tsconfig: Emitter (Shared UI & Utility)
 * @description Generador de ADN (.d.ts) con redirección física de Grafo.
 * Orquesta la emisión de tipos para la fundición visual, inyectando las
 * dependencias de hardware y entorno (React/Node) necesarias para resolver
 * librerías externas.
 *
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Inyección de Ambient Types (Fix TS7016), resolución de Next.js
 * y blindaje de la Maniobra de Redirección de ADN.
 *
 * @author Raz Podestá - MetaShark Tech
 * @license UNLICENSED
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH (Flattened Output) --- */
    "outDir": "../../dist/out-tsc/libs/shared",
    "tsBuildInfoFile": "../../dist/out-tsc/libs/shared/tsconfig.lib.tsbuildinfo",

    /* --- INTEGRIDAD SOBERANA (ADN Emitter) --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "noEmit": false,
    "importHelpers": true,
    "ignoreDeprecations": "5.0",

    /* --- REDIRECCIÓN DE ADN MAESTRO (Fix TS2307 / TS6059) --- */
    /**
     * 🛡️ LEY DEL ENJAMBRE: Consumimos la infraestructura CORE desde sus
     * firmas físicas en dist, garantizando el desacoplamiento total de fuentes.
     */
    "baseUrl": ".",
    "paths": {
      "@floripa-dignidade/exceptions": ["../../dist/out-tsc/libs/core/exceptions/index.d.ts"],
      "@floripa-dignidade/exceptions/*": ["../../dist/out-tsc/libs/core/exceptions/*"],

      "@floripa-dignidade/telemetry": ["../../dist/out-tsc/libs/core/telemetry/index.d.ts"],
      "@floripa-dignidade/telemetry/*": ["../../dist/out-tsc/libs/core/telemetry/*"],

      "@floripa-dignidade/environment-validator": ["../../dist/out-tsc/libs/core/environment-validator/index.d.ts"],
      "@floripa-dignidade/environment-validator/*": ["../../dist/out-tsc/libs/core/environment-validator/*"]
    },

    /* --- RESOLUCIÓN NEXT-GEN (Turbopack & Next 16 Ready) --- */
    "jsx": "react-jsx",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO (Hardware & Library Ambient Types) --- */
    /**
     * 🛡️ SANEADO Zenith: Resolución de TS7016 y TS2591.
     * Inyectamos explícitamente los tipos globales para que el compilador
     * pueda "ver" Lucide, Framer Motion y las APIs de Next.js.
     */
    "types": ["node", "react", "react-dom"],
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"]
  },

  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],

  "exclude": [
    /* 🛡️ LIMPIEZA DE JURISDICCIÓN: Evitamos colisiones de archivos de salida */
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "dist",
    "out-tsc",
    "**/out-tsc/**",
    "node_modules",
    "../../dist",
    "../../node_modules"
  ],

  /**
   * @section Grafo de Referencias Soberanas
   * Mantiene la sincronía física con los cimientos CORE del ecosistema.
   */
  "references": [
    { "path": "../core/exceptions/tsconfig.lib.json" },
    { "path": "../core/telemetry/tsconfig.lib.json" },
    { "path": "../core/environment-validator/tsconfig.lib.json" }
  ]
}
