/**
 * @section tsconfig: Gatekeeper (Shared UI & Utility)
 * @description Orquestador de la frontera física del búnker compartido.
 * Actúa como el escudo de integridad estructural y punto de entrada para el
 * motor de servicios de tipos, delegando la emisión al Emitter local.
 *
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Inyección de referencias core para estabilización del Grafo.
 *
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /**
     * 🛡️ LEY DEL GATEKEEPER:
     * Protege la jurisdicción de archivos 'src' prohibiendo la emisión local.
     */
    "composite": false,
    "noEmit": true,
    "ignoreDeprecations": "5.0"
  },

  /* 🛡️ SINCRONIZACIÓN DE JURISDICCIÓN: No incluimos fuentes aquí. */
  "files": [],
  "include": [],

  /**
   * @section Grafo de Referencias Físicas
   * Sincronizamos la visibilidad con los cimientos CORE para garantizar que
   * el IDE resuelva los ADN bridados sin latencia.
   */
  "references": [
    { "path": "./tsconfig.lib.json" },
    /* --- Dependencias de Infraestructura --- */
    { "path": "../core/exceptions/tsconfig.lib.json" },
    { "path": "../core/telemetry/tsconfig.lib.json" },
    { "path": "../core/environment-validator/tsconfig.lib.json" }
  ]
}
