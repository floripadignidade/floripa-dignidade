/**
 * @section Core Infrastructure - Telemetry Configuration Matrix
 * @description Punto de entrada para el servidor de tipos del búnker de telemetría.
 * Actúa como orquestador de visibilidad local, delegando la validación física
 * al manifiesto de biblioteca especializado (tsconfig.lib.json).
 *
 * Protocolo OEDP-V18.1 - Reference Architecture (Source-First).
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    /**
     * 🛡️ LEY SRE: Protección de frontera física.
     * Se prohíbe la emisión local y la complejidad de proyectos compuestos
     * para forzar la validación directamente sobre los archivos fuente (.ts).
     */
    "composite": false,
    "noEmit": true,
    "ignoreDeprecations": "5.0"
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
