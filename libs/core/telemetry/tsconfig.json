/**
 * @section Core Telemetry - Configuration Gatekeeper
 * @description Punto de entrada maestro para el servidor de tipos de la librería de telemetría.
 * Implementa la doctrina Source-First (OEDP-V18.1), extendiendo la base del monorepo
 * e indexando las fuentes para el TypeScript Project Service y el IDE.
 *
 * Protocolo OEDP-V18.1 - Reference Architecture (Source-First).
 * Normas: ISO/IEC 11179 (Nomenclatura Prosa) e ISO/IEC 25010 (Mantenibilidad).
 * SANEADO: Corrección de herencia relativa (../../../tsconfig.base.json), inclusión de fuentes
 * para Project Service y reconexión de referencia formal hacia tsconfig.lib.json.
 *
 * @author Raz Podestá - MetaShark Tech
 * @license UNLICENSED
 */
{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "ignoreDeprecations": "5.0"
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": ["node_modules", "dist", "out-tsc"],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
