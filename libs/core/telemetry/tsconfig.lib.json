/**
 * @section Core Telemetry - Configuration Gatekeeper
 * @description Punto de entrada maestro para el servidor de tipos de la librería de telemetría.
 * Actúa como pasaporte de visibilidad delegando la auditoría de fuentes al Emitter
 * especializado (tsconfig.lib.json) y extendiendo la constitución base raíz.
 *
 * Protocolo OEDP-V18.1 - Reference Architecture (Source-First).
 * Normas: ISO/IEC 11179 (Nomenclatura Prosa) e ISO/IEC 25010 (Mantenibilidad).
 * SANEADO Zenith: Corrección de ruta relativa hacia la raíz (../../../tsconfig.base.json)
 * y reconexión de referencia formal hacia tsconfig.lib.json.
 *
 * @author Raz Podestá - MetaShark Tech
 * @license UNLICENSED
 */
{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "ignoreDeprecations": "5.0"
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
