{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH (Flattened Output) --- */
    "outDir": "../../../dist/out-tsc/libs/core/telemetry",
    "tsBuildInfoFile": "../../../dist/out-tsc/libs/core/telemetry/tsconfig.lib.tsbuildinfo",

    /* --- INTEGRIDAD SOBERANA (ADN Emitter) --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "noEmit": false,
    "importHelpers": true,

    /**
     * 🛡️ MANIOBRA DE REDIRECCIÓN DE ADN (OEDP-V17.0)
     * SANEADO Zenith: Se elimina el segmento '/src/' de la ruta de resolución.
     * TSC aplana la estructura basándose en rootDir: "src", por lo que el
     * archivo físico resulta en index.d.ts directamente.
     */
    "baseUrl": ".",
    "paths": {
      "@floripa-dignidade/exceptions": [
        "../../../dist/out-tsc/libs/core/exceptions/index.d.ts"
      ]
    },

    /* --- RESOLUCIÓN NEXT-GEN --- */
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO --- */
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"]
  },

  "include": ["src/**/*.ts", "src/**/*.json"],

  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/__tests__/*",
    "jest.config.ts",
    "dist",
    "out-tsc"
  ],

  "references": [
    {
      "path": "../exceptions/tsconfig.lib.json"
    }
  ]
}
