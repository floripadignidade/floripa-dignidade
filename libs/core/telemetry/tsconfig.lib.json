/**
 * @section Core Telemetry - Compiler Infrastructure
 * @description Manifiesto de validación para el motor de tipos del sistema nervioso.
 * Implementa la doctrina OEDP-V18.1: eliminación de baseUrl y uso de rutas
 * relativas explícitas para garantizar resoluciones deterministas.
 *
 * Protocolo OEDP-V18.1 - Reference Architecture (Source-First).
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* --- ESTRATEGIA ZENITH: Cero Sobreingeniería --- */
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,

    /* --- INTEGRIDAD DE RESOLUCIÓN (Modern Standard) --- */
    /**
     * 🛡️ LEY SRE: 'rootDir' apunta al directorio de la librería (.) para
     * permitir la visibilidad de los paths base sin ambigüedad.
     */
    "rootDir": ".",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- RIGOR DE IDENTIDAD (SRE Compliance) --- */
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,

    /* --- ADN DEL ENTORNO (Isomorphic Context) --- */
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"]
  },

  "include": ["src/**/*.ts"],

  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "node_modules",
    "dist",
    "out-tsc",
    "../../../dist"
  ]
}
