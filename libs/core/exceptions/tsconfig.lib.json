/**
 * @section Core Exceptions - Compiler Infrastructure
 * @description Generador de ADN para el motor de tipos del búnker de excepciones.
 * Implementa la doctrina Source-First: valida la integridad lógica directamente
 * desde las fuentes para garantizar latencia cero en el desarrollo.
 *
 * Protocolo OEDP-V18.1 - Reference Architecture (Source-First).
 * SANEADO: Remoción de 'rootDir' para eliminar colisiones TS6059 en entornos CI/CD de Vercel.
 *
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* --- ESTRATEGIA ZENITH: Cero Sobreingeniería --- */
    /**
     * 🛡️ LEY SRE: Desactivamos la emisión física y la complejidad 'composite'.
     * TSC actúa exclusivamente como Auditor de Integridad (Typechecker).
     */
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,

    /* --- INTEGRIDAD DE RESOLUCIÓN (Next-Gen) --- */
    "module": "preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- RIGOR DE IDENTIDAD (SRE Compatibility) --- */
    "ignoreDeprecations": "5.0",
    "importHelpers": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,

    /* --- ADN DEL ENTORNO (Isomorphic Context) --- */
    /**
     * 🛡️ LEY SRE: Soporte para Node.js (Servidor) y Web (Edge).
     * Prohibido cargar librerías DOM aquí para mantener el motor agnóstico.
     */
    "types": ["node"],
    "lib": ["ES2022"]
  },

  "include": ["src/**/*.ts"],

  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "node_modules",
    "dist",
    "out-tsc",
    "../../../../dist"
  ]
}