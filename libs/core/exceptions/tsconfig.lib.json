/**
 * @section tsconfig: Emitter (Exceptions Engine)
 * @description Generador de ADN (.d.ts) con redirección física de Grafo hacia
 * la caché de dist/out-tsc. Orquesta la emisión de tipos del motor de excepciones,
 * garantizando que el resto del enjambre (Core, Engines, Modules) pueda consumir
 * la gramática del fallo de forma Type-Safe.
 *
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Resolución de Grafo físico (Fix TS6059) mediante normalización
 * de rootDir y blindaje de jurisdicción física.
 *
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH --- */
    "outDir": "../../../dist/out-tsc/libs/core/exceptions",
    "tsBuildInfoFile": "../../../dist/out-tsc/libs/core/exceptions/tsconfig.lib.tsbuildinfo",

    /* --- INTEGRIDAD SOBERANA --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "noEmit": false,
    "importHelpers": true,
    "ignoreDeprecations": "5.0",

    /* --- RESOLUCIÓN NEXT-GEN (Bundler Ready) --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    /* --- ADN DEL ENTORNO --- */
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },

  "include":["src/**/*.ts", "src/**/*.json"],

  "exclude":[
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../../dist",
    "../../../node_modules"
  ]
}
