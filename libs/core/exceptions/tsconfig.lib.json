{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc/libs/core/exceptions",
    "tsBuildInfoFile": "../../../dist/out-tsc/libs/core/exceptions/tsconfig.lib.tsbuildinfo",

    /* --- SOBERANÍA DE EMISIÓN (The Emitter) --- */
    /**
     * 🛡️ LEY ZENITH: Composite habilitado.
     * Esto permite que otras librerías referencien este proyecto sin intentar
     * re-compilar su código fuente, usando solo los artefactos en dist.
     */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "src",

    /* --- RESOLUCIÓN ESM MODERNA --- */
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO --- */
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.json"
  ],
  "exclude": [
    /* 🛡️ LIMPIEZA DE JURISDICCIÓN: Evitamos fugas de tipos de tests en la emisión */
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/__tests__/*",
    "jest.config.ts",
    "dist",
    "out-tsc"
  ]
}
