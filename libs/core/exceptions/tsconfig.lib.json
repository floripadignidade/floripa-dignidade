/**
 * @section tsconfig: Emitter (Exceptions Engine)
 * @description Generador de ADN (.d.ts) con redirección física de Grafo.
 * Orquesta la emisión de tipos para la gestión unificada de anomalías,
 * garantizando la soberanía del motor de errores en todo el enjambre.
 *
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH (Flattened Output) --- */
    "outDir": "../../../dist/out-tsc/libs/core/exceptions",
    "tsBuildInfoFile": "../../../dist/out-tsc/libs/core/exceptions/tsconfig.lib.tsbuildinfo",

    /* --- INTEGRIDAD SOBERANA (ADN Emitter) --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "noEmit": false,
    "importHelpers": true,
    "ignoreDeprecations": "5.0",

    /* --- RESOLUCIÓN NEXT-GEN (Alineación Next.js 16+) --- */
    /**
     * 🛡️ LEY ZENITH: Preserve mantiene la estructura de módulos intacta
     * para que Turbopack realice la optimización final de latencia cero.
     */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO (Isomorphic Context) --- */
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.json"
  ],

  "exclude": [
    /* 🛡️ LIMPIEZA DE JURISDICCIÓN: Evitamos fugas de rastro técnico en la emisión */
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/__tests__/*",
    "jest.config.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../../dist",
    "../../../node_modules"
  ]
}
