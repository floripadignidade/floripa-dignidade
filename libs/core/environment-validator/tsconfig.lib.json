/**
 * @section tsconfig: Emitter (Environment Validator)
 * @description Generador de ADN (.d.ts) con redirección física de Grafo.
 * Orquesta la emisión de tipos para la Aduana de Infraestructura, garantizando
 * que el contrato de secretos sea legible para todo el enjambre.
 *
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Erradicación de TS6305 mediante el sellado de rutas físicas
 * y visibilidad isomórfica de tipos de Node.
 *
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH (Flattened Output) --- */
    "outDir": "../../../dist/out-tsc/libs/core/environment-validator",
    "tsBuildInfoFile": "../../../dist/out-tsc/libs/core/environment-validator/tsconfig.lib.tsbuildinfo",

    /* --- INTEGRIDAD SOBERANA (ADN Emitter) --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "noEmit": false,
    "importHelpers": true,
    "ignoreDeprecations": "5.0",

    /* --- REDIRECCIÓN DE ADN MAESTRO (Fix TS6305) --- */
    "baseUrl": ".",
    "paths": {
      /**
       * 🛡️ LEY DEL ENJAMBRE: Consumimos las firmas físicas emitidas en dist.
       * Esto blinda la frontera física y acelera la compilación incremental.
       */
      "@floripa-dignidade/exceptions": ["../../../dist/out-tsc/libs/core/exceptions/index.d.ts"],
      "@floripa-dignidade/telemetry": ["../../../dist/out-tsc/libs/core/telemetry/index.d.ts"]
    },

    /* --- RESOLUCIÓN NEXT-GEN (Bundler Ready) --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO (Isomorphic Context) --- */
    /**
     * 🛡️ LEY SRE: Requerimos tipos de 'node' para procesar 'process.env'
     * en la fase de validación de infraestructura.
     */
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },

  "include": ["src/**/*.ts", "src/**/*.json"],

  "exclude": [
    /* 🛡️ LIMPIEZA DE JURISDICCIÓN */
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../../dist",
    "../../../node_modules"
  ],

  /**
   * @section Grafo de Referencias Soberanas
   */
  "references": []
}
