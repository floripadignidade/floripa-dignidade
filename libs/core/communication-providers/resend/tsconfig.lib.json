/**
 * @section Communication Providers - Resend Compiler Infrastructure
 * @description Manifiesto de verificación de tipos para el búnker de integración transaccional Resend.
 * Rige bajo la doctrina Source-First (OEDP-V18.1), consumiendo directamente el código fuente
 * de las librerías del monorepo a través del mapa de rutas unificado de tsconfig.base.json
 * sin sobreingeniería de proyectos compuestos, emisión intermedia ni referencias a dist.
 *
 * Protocolo OEDP-V18.1 - Reference Architecture (Source-First).
 * Normas: ISO/IEC 11179 (Nomenclatura Prosa) e ISO/IEC 25010 (Mantenibilidad y Rendimiento).
 * SANEADO Zenith: Erradicación definitiva de TS2307 purgando los punteros hacia dist/out-tsc,
 * desactivación de composite/declaration y alineación estricta al estándar noEmit: true.
 *
 * @author Raz Podestá - MetaShark Tech
 * @license UNLICENSED
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../../dist/out-tsc/libs/core/communication-providers/resend",

    /* --- ESTRATEGIA SOURCE-FIRST: Auditoría de Fuentes Pura --- */
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,

    /* --- INTEGRIDAD DE RESOLUCIÓN (Standard Next-Gen) --- */
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- RIGOR DE IDENTIDAD (SRE Compliance) --- */
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,

    /* --- ADN DEL ENTORNO (Node.js & Fetch Context) --- */
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.json"
  ],

  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "jest.config.ts",
    "dist",
    "out-tsc",
    "node_modules",
    "../../../../dist",
    "../../../../node_modules"
  ],

  "references": []
}