/**
 * @section tsconfig: Emitter (Scripts & CLI Orchestrator)
 * @description Generador de ADN (.d.ts) para los disparadores de infraestructura técnica.
 * Orquesta la visibilidad de las herramientas de automatización (Tools), motores
 * de negocio y proveedores, garantizando que los scripts de mantenimiento operen
 * bajo un Grafo de Tipos inexpugnable y sincronizado con la caché de dist.
 *
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Resolución de TS2307 mediante el mapeo de enjambre (Wildcards),
 * sincronización de referencias de proveedores y blindaje de rutas aplanadas.
 *
 * @author Raz Podestá - MetaShark Tech
 * @license UNLICENSED
 */
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH (CLI Cache) --- */
    "outDir": "../dist/out-tsc/scripts",
    "tsBuildInfoFile": "../dist/out-tsc/scripts/tsconfig.lib.tsbuildinfo",

    /* --- INTEGRIDAD SOBERANA (ADN Emitter) --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,

    /**
     * 🛡️ LEY ZENITH: Forzamos rootDir a 'src'.
     * Garantiza que el ADN emitido en dist coincida con el mapa de rutas.
     */
    "rootDir": "src",
    "importHelpers": true,
    "ignoreDeprecations": "5.0",

    /* --- REDIRECCIÓN DE ADN MAESTRO (High Performance SRE) --- */
    /**
     * 🛡️ LEY DEL ENJAMBRE: Consumimos firmas físicas (.d.ts) desde dist.
     * SANEADO: Se inyectan wildcards (/*) en todos los niveles para permitir
     * importaciones profundas de átomos y utilidades sin romper el grafo.
     */
    "baseUrl": ".",
    "paths": {
      /* Capa Tools: El músculo de los scripts */
      "@floripa-dignidade/tools": ["../dist/out-tsc/libs/tools/index.d.ts"],
      "@floripa-dignidade/tools/*": ["../dist/out-tsc/libs/tools/*"],

      /* Capa CORE: Cimientos Inmutables */
      "@floripa-dignidade/telemetry": ["../dist/out-tsc/libs/core/telemetry/index.d.ts"],
      "@floripa-dignidade/telemetry/*": ["../dist/out-tsc/libs/core/telemetry/*"],

      "@floripa-dignidade/exceptions": ["../dist/out-tsc/libs/core/exceptions/index.d.ts"],
      "@floripa-dignidade/exceptions/*": ["../dist/out-tsc/libs/core/exceptions/*"],

      "@floripa-dignidade/environment-validator": [
        "../dist/out-tsc/libs/core/environment-validator/index.d.ts"
      ],
      "@floripa-dignidade/environment-validator/*": [
        "../dist/out-tsc/libs/core/environment-validator/*"
      ],

      "@floripa-dignidade/resend-provider": [
        "../dist/out-tsc/libs/core/communication-providers/resend/index.d.ts"
      ],

      /* Capa ENGINES: Motores de Negocio */
      "@floripa-dignidade/financial-ingestion-engine": [
        "../dist/out-tsc/libs/engines/financial-ingestion-engine/index.d.ts"
      ],
      "@floripa-dignidade/financial-ingestion-engine/*": [
        "../dist/out-tsc/libs/engines/financial-ingestion-engine/*"
      ]
    },

    /* --- RESOLUCIÓN NEXT-GEN (Node.js & ESM Ready) --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO (Node.js Context) --- */
    "types": ["node"],
    "lib": ["ES2022"]
  },

  "files": [],

  "include": ["src/**/*.ts"],

  "exclude": ["node_modules", "dist", "out-tsc", "../dist"],

  /**
   * @section Grafo de Referencias Soberanas
   * SANEADO: Sincronización mandatoria de dependencias físicas del enjambre.
   */
  "references": [
    {
      "path": "../libs/tools/tsconfig.lib.json"
    }
  ]
}
