/**
 * @section tsconfig: Emitter (Scripts & CLI)
 * @description Generador de ADN (.d.ts) para procesos de automatización.
 * Protocolo OEDP-V17.0 - Zenith Architecture Standard.
 * SANEADO Zenith: Resolución de Grafo físico determinista y purga de TS2307.
 *
 * @author Raz Podestá - MetaShark Tech
 */
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    /* --- ESTRATEGIA DE SALIDA ZENITH --- */
    "outDir": "../dist/out-tsc/scripts",
    "tsBuildInfoFile": "../dist/out-tsc/scripts/tsconfig.lib.tsbuildinfo",

    /* --- INTEGRIDAD SOBERANA --- */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "noEmit": false,
    "importHelpers": true,
    "ignoreDeprecations": "5.0",

    /* --- REDIRECCIÓN DE ADN MAESTRO (Fix TS2307) --- */
    /**
     * 🛡️ LEY DEL ENJAMBRE: Consumimos el ADN físico directamente desde la
     * estructura de dist del monorepo, evitando ambigüedades en la resolución.
     */
    "baseUrl": ".",
    "paths": {
      "@floripa-dignidade/telemetry":["../dist/out-tsc/libs/core/telemetry/index.d.ts"],
      "@floripa-dignidade/exceptions":["../dist/out-tsc/libs/core/exceptions/index.d.ts"],
      "@floripa-dignidade/tools":["../dist/out-tsc/libs/tools/index.d.ts"],
      "@floripa-dignidade/financial-ingestion-engine":["../dist/out-tsc/libs/engines/financial-ingestion-engine/index.d.ts"]
    },

    /* --- RESOLUCIÓN NEXT-GEN --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- ADN DEL ENTORNO (Node.js Context) --- */
    "types": ["node"],
    "lib": ["ES2022"]
  },
  "include": ["src/**/*.ts"],
  "exclude":[
    "node_modules",
    "dist",
    "out-tsc",
    "../dist",
    "../node_modules"
  ],
  /**
   * @section Grafo de Referencias Soberanas
   */
  "references":[
    { "path": "../libs/core/exceptions/tsconfig.lib.json" },
    { "path": "../libs/core/telemetry/tsconfig.lib.json" },
    { "path": "../libs/tools/tsconfig.lib.json" }
  ]
}
