/**
 * @section Scripts & Tools - Compiler Infrastructure
 * @description Manifiesto de verificación de tipos para los disparadores de infraestructura.
 * Implementa la doctrina Source-First (OEDP-V18.1): erradica baseUrl, desactiva la emisión
 * física de código y resuelve los tipos institucionales directamente desde las fuentes TypeScript
 * a través de la herencia canónica de tsconfig.base.json.
 *
 * Protocolo OEDP-V18.1 - Reference Architecture (Source-First).
 * SANEADO Zenith: Erradicación definitiva de TS2307 purgando el mapeo huérfano hacia dist/out-tsc,
 * eliminación de la propiedad obsoleta baseUrl y resolución de los bloqueos TS6306 y TS6310
 * aboliendo las referencias compuestas legadas.
 *
 * @author Raz Podestá - MetaShark Tech
 * @license UNLICENSED
 */
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc/scripts",

    /* --- ESTRATEGIA SOURCE-FIRST: Auditoría de Fuentes Pura --- */
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,

    /* --- INTEGRIDAD DE RESOLUCIÓN (Standard Next-Gen) --- */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* --- RIGOR DE IDENTIDAD (SRE Compliance) --- */
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,

    /* --- ADN DEL ENTORNO (Node.js Scripting Context) --- */
    "types": ["node"],
    "lib": ["ES2022"]
  },

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "out-tsc",
    "../dist"
  ],

  "references": []
}
